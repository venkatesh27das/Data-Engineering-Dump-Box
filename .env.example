APP_ENV=development

# Select one provider: lmstudio (local, default) or openai_compatible (remote/self-hosted gateway).
AI_PROVIDER=lmstudio

# LM Studio configuration (used when AI_PROVIDER=lmstudio).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Use the exact identifiers exposed by LM Studio's local /v1/models endpoint.
LMSTUDIO_ORCHESTRATOR_MODEL=
LMSTUDIO_KNOWLEDGE_MODEL=
# Optional for the current POC; leave blank if no embedding model is loaded.
LMSTUDIO_EMBEDDING_MODEL=
# Increase for slower or larger local models.
LMSTUDIO_TIMEOUT_SECONDS=120
# Fail quickly when the LM Studio server itself cannot be reached.
LMSTUDIO_CONNECT_TIMEOUT_SECONDS=10

# OpenAI-compatible gateway configuration (used when AI_PROVIDER=openai_compatible).
# The base URL must include the gateway's OpenAI API prefix, usually /v1.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_ORCHESTRATOR_MODEL=
OPENAI_COMPATIBLE_KNOWLEDGE_MODEL=
# Optional; leave blank when embeddings are not used by your workflow.
OPENAI_COMPATIBLE_EMBEDDING_MODEL=
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=120
OPENAI_COMPATIBLE_CONNECT_TIMEOUT_SECONDS=10

# Aura connection example: neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

DATABASE_URL=sqlite:///./data/app.db

UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts

LOW_CONFIDENCE_THRESHOLD=0.80
AUTO_APPROVE_THRESHOLD=0.95
MAX_UPLOAD_MB=50
