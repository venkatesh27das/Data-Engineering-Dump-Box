APP_ENV=local
USE_MOCK_TOOLS=true
DRY_RUN_DEFAULT=true
DATABRICKS_CATALOG=main
DATABRICKS_BRONZE_SCHEMA=bronze
DATABRICKS_SILVER_SCHEMA=silver
DATABRICKS_OPERATIONS_SCHEMA=operations
QUALITY_POLICY_FILE=resources/sample_quality_policy.yaml
ROUTING_POLICY_FILE=resources/sample_routing_policy.yaml
# DATABRICKS_HOST is supplied by the Databricks App runtime.
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT contains no credential.
