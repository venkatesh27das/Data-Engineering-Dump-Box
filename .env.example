APP_ENV=local
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_UNCOMPRESSED_MB=500
MAX_SHEET_CELLS=2000000
MAX_REGIONS_PER_SHEET=2000
# Optional overrides; otherwise derived from DATA_DIR:
# UPLOAD_DIR=./data/uploads
# OUTPUT_DIR=./data/outputs
# DUCKDB_PATH=./data/excel_intelligence.duckdb
# SQLITE_PATH=./data/runs.sqlite
REGION_AGENT_THRESHOLD=0.70
MAX_AGENT_STEPS=8
MAX_AGENT_REGIONS=20
MAX_TOOL_CELLS=200
LM_TIMEOUT_SECONDS=30
RENDER_TIMEOUT_SECONDS=60
MAX_RENDER_PAGES=20
MAX_EMBEDDING_ASSETS=1000
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=lm-studio
LLM_MODEL=
VLM_MODEL=
EMBEDDING_MODEL=
ENABLE_AGENT=true
ENABLE_VLM=true
ENABLE_EMBEDDINGS=true
ENABLE_LIBREOFFICE_RENDER=false
ENABLE_SUMMARIES=true

LANCEDB_PATH=./data/lancedb
